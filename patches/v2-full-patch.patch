+void MacroAssembler::SandboxedPointerBoundsCheck(Register decoded_pointer,
+                                                  Register byte_length) {
+  ASM_CODE_COMMENT(this);
+#ifdef V8_ENABLE_SANDBOX
+  DCHECK_NE(decoded_pointer, kScratchRegister);
+  DCHECK_NE(byte_length, kScratchRegister);
+  Label ok(this);
+  // Load sandbox_end
+  movq(kScratchRegister, ExternalReference::sandbox_end_address());
+  movq(kScratchRegister, Operand(kScratchRegister, 0));
+  // Check: decoded_pointer + byte_length <= sandbox_end
+  // Equivalently: byte_length <= sandbox_end - decoded_pointer
+  // The SandboxedPtr encoding guarantees decoded_pointer <= sandbox_end,
+  // so sandbox_end - decoded_pointer is non-negative.
+  subq(kScratchRegister, decoded_pointer);
+  cmpq(byte_length, kScratchRegister);
+  j(below_or_equal, &ok);
+  ud2();
+  bind(&ok);
+#endif  // V8_ENABLE_SANDBOX
+}
+
